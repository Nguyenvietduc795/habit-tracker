# Copy file nay thanh .env roi dien gia tri that vao.
# File .env KHONG duoc commit (da nam trong .gitignore).

# --- Database (Supabase / Neon / Postgres local) ---
DATABASE_URL=postgresql://user:password@host:5432/habit_tracker

# --- Backend ---
PORT=3000
# Chuoi bi mat de ky JWT. Sinh ngau nhien, khong dung chu de doan.
JWT_SECRET=
# Thoi gian song cua access token va refresh token
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Frontend ---
# Dia chi backend ma frontend goi toi — CHI dung o local.
# Production de trong: frontend tu goi /api va Vercel chuyen tiep sang Render.
VITE_API_URL=http://localhost:3000

# Dia chi frontend duoc phep goi API (ngan cach bang dau phay)
CORS_ORIGINS=http://localhost:5173

# Duong dan cookie refresh token trinh duyet nhin thay (production qua proxy: /api/auth)
COOKIE_PATH=/auth
