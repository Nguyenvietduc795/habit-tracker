# Copy file nay thanh .env roi dien gia tri that vao.
# File .env KHONG duoc commit (da nam trong .gitignore).

# --- Database (Supabase / Neon / Postgres local) ---
DATABASE_URL=postgresql://user:password@host:5432/habit_tracker

# --- Backend ---
PORT=3000
# Chuoi bi mat de ky JWT. Sinh ngau nhien, khong dung chu de doan.
JWT_SECRET=
# Thoi gian song cua access token va refresh token
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Frontend ---
# Dia chi backend ma frontend goi toi
VITE_API_URL=http://localhost:3000
